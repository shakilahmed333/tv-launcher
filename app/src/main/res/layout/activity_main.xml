<?xml version="1.0" encoding="utf-8"?>
<!-- Light home screen over a nature photo. Sizes in dp for a 1080p TV (about 960 x 540 dp). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false">

    <!-- 1. Photo of the day -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- 2. Weather tint + animations -->
    <com.shakil.tvlauncher.WeatherView
        android:id="@+id/weatherFx"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- 3. Soft shade at the top for the white text, light wash at the bottom for the app rows -->
    <View
        android:id="@+id/topShade"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="top"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/bottomWash"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_gravity="bottom"
        android:importantForAccessibility="no" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingTop="26dp"
            android:paddingEnd="48dp"
            android:paddingBottom="40dp">

            <!-- Greeting + status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="-0.01"
                        android:shadowColor="@color/photo_shadow"
                        android:shadowDy="2"
                        android:shadowRadius="12"
                        android:textColor="@color/on_photo"
                        android:textSize="28sp" />

                    <TextClock
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.92"
                        android:format12Hour="EEEE, d MMMM"
                        android:format24Hour="EEEE, d MMMM"
                        android:shadowColor="@color/photo_shadow"
                        android:shadowDy="1"
                        android:shadowRadius="8"
                        android:textColor="@color/on_photo"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Wi-Fi status pill -->
                <LinearLayout
                    android:id="@+id/netPill"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp">

                    <View
                        android:id="@+id/netDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp" />

                    <ImageView
                        android:id="@+id/netIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_wifi" />

                    <TextView
                        android:id="@+id/netText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/panelBtn"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/card"
                    android:contentDescription="@string/control_panel"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_panel" />

                <TextView
                    android:id="@+id/settingsBtn"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/card"
                    android:contentDescription="@string/settings"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="⚙"
                    android:textColor="@color/text"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Big clock + weather card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="10dp"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextClock
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-thin"
                    android:format12Hour="h:mm"
                    android:format24Hour="H:mm"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:shadowColor="@color/photo_shadow"
                    android:shadowDy="3"
                    android:shadowRadius="18"
                    android:textColor="@color/on_photo"
                    android:textSize="104sp" />

                <LinearLayout
                    android:id="@+id/weatherCard"
                    android:layout_width="300dp"
                    android:layout_height="140dp"
                    android:background="@drawable/card"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/weatherIcon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_partly" />

                        <TextView
                            android:id="@+id/weatherTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="sans-serif-light"
                            android:includeFontPadding="false"
                            android:text="--°"
                            android:textColor="@color/text"
                            android:textSize="40sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/city_name"
                            android:textColor="@color/accent"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/weatherLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/weather_loading"
                        android:textColor="@color/text"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/weatherChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal" />
                </LinearLayout>
            </LinearLayout>

            <!-- Most used -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="@color/photo_shadow"
                android:shadowDy="1"
                android:shadowRadius="8"
                android:text="@string/most_used"
                android:textColor="@color/on_photo"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/favRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal" />

            <!-- Name of the focused app, slides under the tile -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:clipChildren="false">

                <TextView
                    android:id="@+id/focusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:alpha="0"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text"
                    android:textSize="13sp" />
            </FrameLayout>

            <!-- All apps -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/all_apps"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <GridLayout
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:columnCount="8"
                android:useDefaultMargins="false" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
